// clang-format off

#version 460

#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

struct MDICommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int vertexOffset;
    uint firstInstance;
};

layout(buffer_reference, scalar) buffer MDICommandPtr {
    MDICommand commands[];
};

struct RenderItem {
    mat4 world;
    uint materialId;
};

layout(buffer_reference, scalar) buffer RenderItemPtr {
    RenderItem items[];
};

struct RenderObject {
    mat4 world;
    uint materialId;

    uint indexCount;
    uint firstIndex;
    int vertexOffset;
};

layout(buffer_reference, scalar) readonly buffer RenderObjectPtr {
    RenderObject objects[];
};

layout(buffer_reference, scalar) buffer atomicPtr {
    uint counter;
};

layout(push_constant, scalar) uniform ComputeConstants {
    uint64_t renderItemBufferAddress;
    uint64_t mdiBufferAddress;
    uint64_t renderObjectBufferAddress;
    uint64_t atomicBufferCounterAddress;
    uint totalObjects;
} pc;

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

bool checkFrustum() {
    return true;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.totalObjects) return;

    RenderObjectPtr roBuffer = RenderObjectPtr(pc.renderObjectBufferAddress);
    MDICommandPtr mdiCmdBuffer = MDICommandPtr(pc.mdiBufferAddress);
    RenderItemPtr riBuffer = RenderItemPtr(pc.renderItemBufferAddress);
    atomicPtr counterBuffer = atomicPtr(pc.atomicBufferCounterAddress);

    RenderObject obj = roBuffer.objects[i];
    
    bool isVisible = checkFrustum();

    if (isVisible) {
        // TODO: atomicAdd()
        uint drawIdx = atomicAdd(counterBuffer.counter, 1);

        // MDI command
        MDICommand cmd;
        cmd.indexCount = obj.indexCount;
        cmd.instanceCount = 1;
        cmd.firstIndex = obj.firstIndex;
        cmd.vertexOffset = obj.vertexOffset;
        cmd.firstInstance = drawIdx;
        
        mdiCmdBuffer.commands[drawIdx] = cmd;

        // Render item
        RenderItem ri;
        ri.world = obj.world;
        ri.materialId = obj.materialId;

        riBuffer.items[drawIdx] = ri;
    }
}